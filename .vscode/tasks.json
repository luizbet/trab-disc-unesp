{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar com pdflatex",
            "type": "shell",
            "command": "pdflatex",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "main.tex"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$latex"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Compilar com bibtex (completo)",
            "type": "shell",
            "command": "pdflatex",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "main.tex"
            ],
            "dependsOn": ["Executar bibtex"],
            "group": "build",
            "problemMatcher": ["$latex"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Executar bibtex",
            "type": "shell",
            "command": "bibtex",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "args": ["main"],
            "group": "build",
            "problemMatcher": ["$bibtex"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Limpar arquivos auxiliares",
            "type": "shell",
            "command": "rm",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "args": [
                "-f",
                "*.aux",
                "*.log",
                "*.out",
                "*.toc",
                "*.lof",
                "*.lot",
                "*.fls",
                "*.fdb_latexmk",
                "*.synctex.gz",
                "*.bbl",
                "*.blg"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ],
    "inputs": [],
    "problemMatchers": {
        "$bibtex": {
            "owner": "bibtex",
            "fileLocation": ["relative", "${workspaceFolder}"],
            "pattern": {
                "regexp": "^(.*):(\\d+):\\s+(.*)$",
                "file": 1,
                "line": 2,
                "message": 3
            }
        }
    }
}
