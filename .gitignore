# ============================================================
# .gitignore para trab-disc-unesp
# ============================================================

# --- Arquivos auxiliares do LaTeX ---
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*-blx.aux
*-blx.bib

# --- Backups e arquivos temporários ---
*.bak
*.bak[0-9]*
*.sav
*.backup
*.swp
*.~[0-9]*
*.tmp
*.temp

# --- Arquivos do sistema ---
.DS_Store
Thumbs.db
desktop.ini

# --- Pastas de cache ---
latex.out/
_minted*/
.texpadtmp

# --- Configurações pessoais do VS Code ---
.vscode/settings.local.json
.vscode/argv.json
.vscode/extensions.json.local

# --- Arquivos compilados na pasta src ---
src/*.aux
src/*.log
src/*.out
src/*.toc
src/*.lof
src/*.lot
src/*.fls
src/*.fdb_latexmk
src/*.synctex.gz
src/*.bbl
src/*.blg
src/*.bcf
src/*.run.xml
src/*-blx.aux
src/*-blx.bib

# --- NÃO IGNORAR OS PDFs (queremos versioná-los) ---
# output/

# ============================================================
# FIM DO .gitignore
# ============================================================
